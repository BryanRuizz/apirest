{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "node_modules/swagger-ui-dist/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
    "crons": [
    {
      "path": "/api/v1/workouts/cities",
      "schedule": "0 12 * * 1,5"
    },
    {
      "path": "/api/v1/workouts/cities",
      "schedule": "0 16 * * 1,5"
    }
  ]
}